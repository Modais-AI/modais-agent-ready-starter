{
  "name": "agent-ready-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run security:secrets",
    "commit:safe": "node scripts/git/safe-commit.mjs",
    "security:secrets": "node scripts/security/check-secrets.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "setup:local": "node scripts/setup-local.mjs",
    "supabase:types": "supabase gen types typescript --linked > src/lib/supabase/database.types.ts",
    "setup:guided": "node scripts/setup-guided.mjs",
    "setup:doctor": "node scripts/setup-doctor.mjs",
    "supabase:verify": "node scripts/setup-doctor.mjs --supabase-only"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.110.0",
    "lucide-react": "1.23.0",
    "next": "16.4.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "overrides": {
    "postcss": "8.5.16"
  }
}
